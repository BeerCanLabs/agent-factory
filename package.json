{
  "name": "@beercanlabs/agent-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Headless infrastructure for portable autonomous agent cartridges",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "build": "node scripts/build-workspaces.mjs",
    "test": "npm run build && npm run test --workspaces --if-present",
    "validate": "npm exec -w @beercanlabs/factory-contract -- tsx src/cli.ts validate --all ../../agents"
  },
  "keywords": [
    "ai-agents",
    "bedrock",
    "vertex-ai",
    "mcp",
    "agent-infrastructure"
  ],
  "author": "BeerCanLabs",
  "license": "Apache-2.0"
}
