# direnv: keep this repo on BeerCanLabs AWS only. Frontline profiles are invisible here.
export AWS_CONFIG_FILE="$HOME/.aws/beercanlabs/config"
export AWS_SHARED_CREDENTIALS_FILE="$HOME/.aws/beercanlabs/credentials"
export AWS_PROFILE=beercanlabs-deploy
unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_DEFAULT_PROFILE
# Set once the BeerCanLabs account exists:
# export BCL_AWS_ACCOUNT_ID=000000000000
