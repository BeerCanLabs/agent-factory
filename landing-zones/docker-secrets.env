# Names the factory will bind. Fill values on the landing zone; do not commit real secrets.
# Provider keys are read only by the egress gateway. Agents never see them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ECHO_WEBHOOK_SECRET=dev-echo-webhook
FACTORY_LEDGER_TOKEN=dev-ledger
# Discord is optional — leave empty until an agent has a discord surface.
DISCORD_BOT_TOKEN=
